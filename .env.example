# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ===================================================================
# TELEGRAM BOT & AUTHENTICATION CONFIGURATION
# ===================================================================
# TELEGRAM_BOT_TOKEN: Bot token obtained from @BotFather.
# Required on the server to verify Telegram WebApp initData HMAC-SHA256 signature.
# NEVER expose this token to the frontend client.
TELEGRAM_BOT_TOKEN=""

# SESSION_SECRET: High-entropy secret string used to sign session cookies/tokens.
SESSION_SECRET="change-this-to-a-secure-random-32-byte-hex-secret"

# ALLOW_DEMO_AUTH: Set to "true" to allow a sandboxed demo session when testing
# outside Telegram (e.g. in desktop browser preview). Always "false" in production.
ALLOW_DEMO_AUTH="true"

# ===================================================================
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# ===================================================================
# SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Supabase Service Role Key (with RLS bypass for backend only).
# NEVER expose this key to the frontend client. Keep strictly on server.
SUPABASE_SERVICE_ROLE_KEY=""
